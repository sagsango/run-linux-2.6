#!/bin/sh

# 1. Mount essential pseudo-filesystems
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev 2>/dev/null || mount -t tmpfs none /dev
mount -t debugfs none /sys/kernel/debug

# 2. Populate device nodes and handle hotplug events
mkdir -p /dev/pts /dev/shm
mount -t devpts none /dev/pts
echo /sbin/mdev > /proc/sys/kernel/hotplug
mdev -s

# 3. Mount a writable scratch space for logs/tools
mkdir -p /tmp
mount -t tmpfs none /tmp

# 4. Enable Kernel crash dumping and troubleshooting paths
echo 1 > /proc/sys/kernel/sysrq
echo "0" > /proc/sys/kernel/printk

# 5. Bring up local network loopback interface
ifconfig lo 127.0.0.1 up

# 6. Welcome Banner & Hardware Summary
echo "=================================================="
echo " SUCCESS! Your Linux Kernel 2.6.39 System Is Alive! "
echo "=================================================="
echo "CPU info:" && head -n 4 /proc/cpuinfo
echo "Memory Available:" && free -m
echo "Detected Block Devices:" && ls -l /dev/sd* /dev/vd* 2>/dev/null

# 7. Execute the interactive shell with explicit TTY setup
exec /bin/sh

