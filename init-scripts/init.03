#!/bin/sh

# 1. Mount essential pseudo-filesystems
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev 2>/dev/null || mount -t tmpfs none /dev
mount -t debugfs none /sys/kernel/debug

# 2. Populate device nodes and handle hotplug events
mkdir -p /dev/pts /dev/shm
mount -t devpts none /dev/pts
echo /sbin/mdev > /proc/sys/kernel/hotplug
mdev -s

# 3. Mount a writable scratch space for logs/tools
mkdir -p /tmp
mount -t tmpfs none /tmp

# 4. Enable Kernel crash dumping and troubleshooting paths
echo 1 > /proc/sys/kernel/sysrq
echo "0" > /proc/sys/kernel/printk

# 5. Bring up local network loopback interface
ifconfig lo 127.0.0.1 up


# mount disk
echo "-------- init_script::mount disk ---------"
mkdir /mnt
mkdir /mnt/disk
mount -t ext3 /dev/sda /mnt/disk


# configure swap device
echo "------- init_script::configure swap device ----------"
# Ensure the device file exists before trying to read it
if [ -b /dev/sdb ]; then
    echo "----> init_script::Configuring swap device /dev/hdb..."

    # Check if the block device already has a valid swap signature
    if ! blkid /dev/sdb | grep -q "TYPE=\"swap\""; then
        echo "   init_script::No swap signature found. Formating /dev/sdb..."
        mkswap /dev/sdb
    fi

    # Activate the swap partition
    swapon /dev/sdb
else
    echo "--> init_script::Warning: /dev/sdb block device not found."
fi


# 6. Welcome Banner & Hardware Summary
echo "=================================================================="
echo " init_script::SUCCESS! Your Linux Kernel 2.6.39 System Is Alive! "
echo "=================================================================="
echo "init_script::CPU info:" && head -n 4 /proc/cpuinfo
echo "init_script::Memory Available:" && free -m
echo "init_script::Detected Block Devices:" && ls -l /dev/sd* /dev/vd* 2>/dev/null

# 7. Execute the interactive shell with explicit TTY setup
exec /bin/sh

